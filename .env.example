# --- HLStatsX Database Settings ---
DB_ROOT_PASS=hlstats_root_pass
DB_NAME=hlstatsx
DB_USER=hlstatsx
DB_PASS=hlstatsx_password
DB_PORT=3306

# --- MariaDB Performance Tuning (MariaDB Stock Default vs. HLstatsX Recommended) ---
# RAM cache for InnoDB tables & indexes (MariaDB default: 128M | Recommended: 512M, use 1G-2G for 10M+ rows)
DB_BUFFER_POOL_SIZE=512M
# Transaction flush policy (MariaDB default: 1 [strict ACID/slow] | Recommended: 2 [flush to OS cache/10x-30x faster])
DB_FLUSH_LOG_AT_TRX_COMMIT=2
# Log buffer before disk flush (MariaDB default: 16M | Recommended: 16M, use 32M for large batch inserts)
DB_LOG_BUFFER_SIZE=16M
# Maximum simultaneous DB connections (MariaDB default: 151 | Recommended: 200)
DB_MAX_CONNECTIONS=200
# Cache for open table descriptors (MariaDB default: 400 | Recommended: 2000 for 55+ tables)
DB_TABLE_OPEN_CACHE=2000

# --- HLStatsX General Settings ---
# Secret key for communication (must match your hlstatsx panel / SuperLogs config. PROXY_KEY secret, dummy_key, change it!)
PROXY_KEY=d7fe18f9c4d10180f2aa6393
# External port for the web interface
WEB_PORT=80

# --- Network Routing ---
# Internal Docker hostname of the Daemon container (used for inter-container communication)
DAEMON_HOST=hlx-daemon

# --- External Communication Ports ---
# UDP & TCP (HTTP) port for the Perl Daemon (Direct log receiver)
DAEMON_PORT=27500

# --- Container Timezone for Cron Jobs, Logs ---
# IANA timezone examples: Europe/Budapest, Europe/London, America/New_York
TZ=Europe/Budapest

# Optional: Uncomment the lines below ONLY if you want to enable the Legacy UDP Forwarder container:
# COMPOSE_PROFILES=forwarder

# Optional: UDP port for the Forwarder (Where game servers send their logs)
#FORWARDER_PORT=26999

# --- Game Server Identification ---
# Optional: used only by the UDP Forwarder.
# Identifies the game server whose logs are forwarded by this container.
#GAME_SERVER_IP=192.168.1.1
#GAME_SERVER_PORT=27015
