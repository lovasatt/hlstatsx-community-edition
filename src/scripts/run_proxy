# For support and installation notes visit http://www.hlxcommunity.com

# Change to directory of script
cd "$(dirname "$0")"

confdir=.
conffile=hlstats.conf
daemonfile=proxy-daemon.pl
logdir=logs
logfile=proxy_$(date +%Y%m%d_%H-%M-%S).log
piddir=${confdir}
pidfile=${piddir}/proxy-daemon.pid

# Verify that we can see the daemon file
if [ ! -f "${daemonfile}" ]; then
        echo "CRITICAL ERROR: Can't find the daemon file (${daemonfile})"
        exit 1
fi

# Verify write access to directories
if [ ! -w "${confdir}" ]; then
        echo "CRITICAL ERROR: You need write access to ${confdir}"
        exit 1
fi

# Create logs directory if needed
if [ ! -d "${logdir}" ]; then
        mkdir -p "${logdir}"
fi

if [ ! -w "${logdir}" ]; then
        echo "CRITICAL ERROR: You need write access to ${logdir}"
        exit 1
fi

function get_pid {
        if [ -f "${pidfile}" ]; then
                cat "${pidfile}" 2>/dev/null
        fi
}

function start_proxy {
        if [ ! -f "${conffile}" ]; then
                echo "CRITICAL ERROR: Missing configuration file (${conffile})"
                exit 1
        fi

        local PID=$(get_pid)
        if [ -n "${PID}" ]; then
                kill -0 "${PID}" &>/dev/null
                if [ $? -eq 0 ]; then
                        echo "HLstatsX:CE Proxy Daemon is already running (PID: ${PID})!"
                        return 2
                else
                        rm -f "${pidfile}"
                fi
        fi

        echo -n "Starting HLstatsX:CE Proxy Daemon... "
        ./"${daemonfile}" --configfile="${conffile}" > "${logdir}/${logfile}" 2>&1 &
        local NEW_PID=$!
        echo "${NEW_PID}" > "${pidfile}"

        sleep 1
        kill -0 "${NEW_PID}" &>/dev/null
        if [ $? -eq 0 ]; then
                echo "Started successfully (PID: ${NEW_PID})"
                return 0
        else
                echo "FAILED to start! Check log file: ${logdir}/${logfile}"
                rm -f "${pidfile}"
                return 1
        fi
}

function stop_proxy {
        local PID=$(get_pid)
        if [ -z "${PID}" ]; then
                echo "No HLstatsX:CE Proxy Daemon running (no PID file)."
                return 3
        fi

        echo -n "Stopping HLstatsX:CE Proxy Daemon (PID: ${PID})... "
        kill -INT "${PID}" &>/dev/null

        local i=1
        while [ $i -le 5 ]
        do
                kill -0 "${PID}" &>/dev/null
                if [ $? -ne 0 ]; then
                        rm -f "${pidfile}"
                        echo "Stopped successfully."
                        return 0
                fi
                sleep 1
                let i++
        done

        # If not stopped gracefully, force kill
        echo -n "Forcing shutdown... "
        kill -KILL "${PID}" &>/dev/null
        sleep 1
        rm -f "${pidfile}"
        echo "Stopped forcefully."
        return 1
}

case "$1" in
        start)
                start_proxy
        ;;

        stop)
                stop_proxy
        ;;

        restart)
                echo "Restarting HLstatsX:CE Proxy Daemon..."
                stop_proxy
                sleep 1
                start_proxy
        ;;

        status)
                PID=$(get_pid)
                if [ -n "${PID}" ]; then
                        kill -0 "${PID}" &>/dev/null
                        if [ $? -eq 0 ]; then
                                echo "HLstatsX:CE Proxy Daemon is running (PID: ${PID})."
                                exit 0
                        else
                                echo "Stale PID file found (process not running). Removing..."
                                rm -f "${pidfile}"
                                exit 1
                        fi
                else
                        echo "HLstatsX:CE Proxy Daemon is NOT running."
                        exit 0
                fi
        ;;

        *)
                echo "Usage: ./run_proxy [ start | stop | restart | status ]"
                exit 1
        ;;
esac

exit 0